# PayGate Dashboard — Environment Configuration
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
#
# SECURITY NOTE:
# All VITE_* variables are bundled into the browser build and are publicly visible.
# NEVER put secrets here (DB_PASSWORD, ADMIN_API_KEY, MIDTRANS_SERVER_KEY,
# webhook signing secrets, merchant secret keys, etc.).

# Backend API base URL (required for production builds; non-local production must be HTTPS)
VITE_API_BASE_URL=http://localhost:8081

# Development-only payment simulator. Leave false in staging/production.
# Never put an API key or any other secret in a VITE_* variable.
VITE_ENABLE_SIMULATOR=false
